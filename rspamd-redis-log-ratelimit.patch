+  -- read_servers and write_servers are often the same list; uploading twice
+  -- doubles the connection-refused noise when Redis is down.
+  local seen = {}
+  local unique = {}
+  for _, s in ipairs(servers) do
+    if not seen[s] then
+      seen[s] = true
+      unique[#unique + 1] = s
+    end
+  end
+  servers = unique
+
