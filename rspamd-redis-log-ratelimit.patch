+-- When Redis is down, every worker retries script upload on a timer and again
+-- on every scanned message. Log the first failure and then at most once a
+-- minute so a missing Redis cannot fill the disk.
+local SCRIPT_ISSUE_LOG_INTERVAL = 60
+
+local function log_script_issue(ctx, script, fmt, ...)
+  local now = os.time()
+  script.issue_suppressed = (script.issue_suppressed or 0) + 1
+  if script.last_issue_log and (now - script.last_issue_log) < SCRIPT_ISSUE_LOG_INTERVAL then
+    return
+  end
+  local extra = ''
+  if script.last_issue_log and script.issue_suppressed > 1 then
+    extra = string.format(' (%d similar messages suppressed)', script.issue_suppressed - 1)
+  end
+  script.last_issue_log = now
+  script.issue_suppressed = 0
+  logger.infox(ctx, fmt .. extra, ...)
+end
+
+local function clear_script_issue(script)
+  script.last_issue_log = nil
+  script.issue_suppressed = 0
+end
